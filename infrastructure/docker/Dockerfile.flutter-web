# The Flutter app, built for the web.
#
# There is one app: apps/flutter. This image exists so a deployment can serve it from the same place as everything else
# rather than from a machine with a toolchain on it.
#
#   docker build -f infrastructure/docker/Dockerfile.flutter-web -t vimbai/flutter-web apps/flutter

FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /app
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get
COPY . .
RUN flutter build web --release

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/build/web /usr/share/nginx/html
# a single-page app: every path is the app, not a file on disk
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / { try_files $uri $uri/ /index.html; }\n  location = /health { return 200 "ok"; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/health || exit 1
