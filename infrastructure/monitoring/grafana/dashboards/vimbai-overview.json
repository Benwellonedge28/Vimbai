{
  "dashboard": {
    "title": "Vimbai Platform Overview",
    "tags": ["vimbai", "overview"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Request Rate (req/s)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [{"expr": "sum(rate(http_server_duration_seconds_count[5m])) by (service_name)"}],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "title": "Error Rate (%)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [{"expr": "sum(rate(http_server_duration_seconds_count{http_status_code=~\"5..\"}[5m])) / sum(rate(http_server_duration_seconds_count[5m])) * 100"}],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "title": "P95 Latency (ms)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_duration_seconds_bucket[5m])) by (le, service_name)) * 1000"}],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "title": "Active Services",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [{"expr": "count(count(up) by (service_name))"}],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8}
      },
      {
        "title": "Circuit Breaker Open Count",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [{"expr": "sum(circuit_breaker_open)"}],
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 8}
      },
      {
        "title": "Service Health Status",
        "type": "table",
        "datasource": "Prometheus",
        "targets": [{"expr": "up", "legendFormat": "{{service_name}}"}],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "30s"
  }
}
