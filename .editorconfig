# Editors follow this so a diff contains the change and not a whitespace argument.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{rs,toml}]
indent_size = 4
# rustfmt decides the layout; this only keeps editors from fighting it.
max_line_length = 120

[*.{go,mod,sum}]
indent_style = tab

[*.{yaml,yml,json,dart}]
indent_size = 2

[*.md]
# Trailing spaces are meaningful in Markdown line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
