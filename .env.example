# Vimbai Environment Configuration Example
# Copy this file to .env and fill in the values for local development

# Neo4j Database
NEO4J_PASSWORD=ChangeMe_Str0ng_Pass!

# JWT Secret (IMPORTANT: Change this to a strong random secret in production!)
JWT_SECRET=ChangeThisToAStrongRandomSecret2026

# API Gateway
API_GATEWAY_PORT=8081

# Service URLs (for internal docker network)
IDENTITY_SERVICE_URL=http://identity-service:8080
ACCOUNTING_SERVICE_URL=http://accounting-service:8000
FINANCE_SERVICE_URL=http://finance-service:8001
MULTIMODAL_SERVICE_URL=http://multimodal-pipeline-service:8002
BANKING_INTEGRATION_SERVICE_URL=http://banking-integration-service:8003
SUPPLY_CHAIN_SERVICE_URL=http://supply-chain-service:8004
FRAUD_DETECTION_SERVICE_URL=http://fraud-detection-service:8005
WORKFLOW_SERVICE_URL=http://workflow-service:8006
REPORTING_SERVICE_URL=http://reporting-service:8007
AUTOMATION_ENGINE_SERVICE_URL=http://automation-engine-service:8008

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=vimbai_mq
RABBITMQ_PASS=ChangeMe_Str0ng_MQ_Pass!

# Mobile Client (for offline mode)
OFFLINE_SYNC_ENABLED=true
LOCAL_DB_PATH=./vimbai_offline.db
