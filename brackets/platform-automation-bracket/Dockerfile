FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Non-root user
RUN addgroup --system vimbai && adduser --system --ingroup vimbai vimbai

COPY brackets/platform-automation-bracket/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY brackets/platform-automation-bracket/main.py ./main.py
COPY admin-service ./admin-service
COPY alerts-service ./alerts-service
COPY automation-engine ./automation-engine
